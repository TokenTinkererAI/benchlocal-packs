{
  "name": "hmmt-feb-2026",
  "version": "1.0.0",
  "description": "BenchLocal Bench Pack for HMMT February 2026 (33 competition math problems from the Harvard-MIT Mathematics Tournament) - boxed-answer extraction with textual LaTeX normalization, no execution needed.",
  "license": "MIT",
  "author": "TokenTinkerer",
  "scripts": {
    "build:dataset": "node scripts/generate-dataset.mjs",
    "build:benchlocal": "tsc -p tsconfig.benchlocal.json",
    "build:cli": "tsc -p tsconfig.cli.json",
    "build": "npm run build:benchlocal && npm run build:cli",
    "typecheck": "tsc --noEmit",
    "cli": "npm run build:cli && node dist-cli/cli/run.js",
    "check:extraction": "npm run build:cli && node scripts/check-extraction.mjs",
    "mock": "node scripts/mock-server.mjs",
    "probe": "node _reference/probe-pack.mjs",
    "pack": "npm run build:benchlocal && node scripts/pack-artifact.mjs"
  },
  "dependencies": {
    "@benchlocal/core": "0.3.0",
    "@benchlocal/sdk": "0.3.0"
  },
  "devDependencies": {
    "@types/node": "latest",
    "typescript": "latest"
  }
}
